# Copy this file to `.env` and fill in your free API keys.
# `.env` is gitignored and must never be committed.

# AbuseIPDB  — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# URLhaus (abuse.ch) — https://auth.abuse.ch/  (Auth-Key)
URLHAUS_AUTH_KEY=

# --- Optional tuning (sensible defaults applied if left unset) ---
# Per-request HTTP timeout, seconds.
HTTP_TIMEOUT=15
# Bounded retries on transient failures (429 / 5xx / connection). 0 disables.
HTTP_RETRIES=2
# AbuseIPDB report lookback window (days) used for score + categories.
ABUSEIPDB_MAX_AGE_DAYS=90
